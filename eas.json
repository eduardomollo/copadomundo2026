{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local",
    "autoIncrement": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "ios": {
        "resourceClass": "m-medium",
        "image": "latest"
      },
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "dumollo@hotmail.com",
        "ascAppId": "6775386986",
        "appleTeamId": "H8CD63AB96"
      }
    }
  }
}
